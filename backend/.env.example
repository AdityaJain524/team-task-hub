# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string. On Railway this is injected automatically
# when you link a Postgres service to this deployment.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_task_hub

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all (dev only)
CORS_ORIGIN=http://localhost:5173

# ─── Seeding ──────────────────────────────────────────────────────────────────
# Default admin account created by `npm run db:init`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=System Admin
